DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-very-long-secure-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,foresta.aguasyservicioslaz.cl,api-foresta.aguasyservicioslaz.cl, localhost:8000
SERVE_API_DOCS=false

TIME_ZONE=America/Santiago

DB_ENGINE=mysql
DB_NAME=cpanel_database_name
DB_USER=cpanel_database_user
DB_PASSWORD=replace-db-password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=30
DB_CONN_HEALTH_CHECKS=true
# Solo aplica si DB_ENGINE=sqlite en local. Ayuda a evitar "database is locked" durante imports largos.
SQLITE_TIMEOUT_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://foresta.aguasyservicioslaz.cl
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://foresta.aguasyservicioslaz.cl

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_ROTATE_REFRESH_TOKENS=false
JWT_BLACKLIST_AFTER_ROTATION=false
JWT_UPDATE_LAST_LOGIN=false

API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=50
LOG_LEVEL=WARNING

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_ENGINE=django.contrib.sessions.backends.signed_cookies

CACHE_DEFAULT_TIMEOUT=300
CACHE_MAX_ENTRIES=1000
DASHBOARD_CACHE_SECONDS=60
DASHBOARD_MAX_RANGE_DAYS=120
FINANCE_SUMMARY_CACHE_SECONDS=45
MAPS_OWNERS_CACHE_SECONDS=120
MAPS_OPTIONS_CACHE_SECONDS=120
MAPS_VISIT_SUMMARY_CACHE_SECONDS=45

AUDIT_TRAIL_ENABLED=true
AUDIT_LOG_READS=false
AUDIT_LOG_PAYLOAD=false
AUDIT_LOG_QUERY_PARAMS=true
AUDIT_MAX_PAYLOAD_BYTES=2000
SESSION_AUDIT_ENABLED=true
SESSION_AUDIT_LOG_REFRESH=false
CURRENT_USER_AUTHENTICATE_SAFE_METHODS=false

# Integracion server-to-server con Nodotech IoT.
# Estas credenciales son solo del backend Foresta; no exponerlas en el frontend.
NODOTECH_API_BASE_URL=https://nodotech.aguasyservicioslaz.cl/api/v1
NODOTECH_EMAIL=replace-nodotech-user@example.com
NODOTECH_PASSWORD=replace-nodotech-password
NODOTECH_REQUEST_TIMEOUT=10
NODOTECH_DEFAULT_PULSE_MS=700
NODOTECH_ACCESS_TOKEN_CACHE_SECONDS=840
NODOTECH_REFRESH_TOKEN_CACHE_SECONDS=604800
