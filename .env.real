
DJANGO_ENV=production
DJANGO_SECRET_KEY=tu-clave-real-larga-y-segura
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api-foresta.aguasyservicioslaz.cl

TIME_ZONE=America/Santiago

# 🔴 CAMBIO CLAVE
DB_ENGINE=mysql
DB_NAME=aguasyse_comunidad
DB_USER=aguasyse_admin
DB_PASSWORD=xd21proclus
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://foresta.aguasyservicioslaz.cl,https://fnodotech.aguasyservicioslaz.cl
CSRF_TRUSTED_ORIGINS=https://foresta.aguasyservicioslaz.cl,
https://fnodotech.aguasyservicioslaz.cl

JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=30
API_PAGE_SIZE=25
LOG_LEVEL=INFO


VITE_APP_BASE_NAME=/
VITE_API_BASE_URL=https://api-foresta.aguasyservicioslaz.cl/api/v1

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_ENGINE=django.contrib.sessions.backends.signed_cookies

CACHE_DEFAULT_TIMEOUT=300
CACHE_MAX_ENTRIES=1000
DASHBOARD_CACHE_SECONDS=60
DASHBOARD_MAX_RANGE_DAYS=120
FINANCE_SUMMARY_CACHE_SECONDS=45
MAPS_OWNERS_CACHE_SECONDS=120
MAPS_OPTIONS_CACHE_SECONDS=120
MAPS_VISIT_SUMMARY_CACHE_SECONDS=45

AUDIT_TRAIL_ENABLED=true
AUDIT_LOG_READS=false
AUDIT_LOG_PAYLOAD=false
AUDIT_LOG_QUERY_PARAMS=true
AUDIT_MAX_PAYLOAD_BYTES=2000
SESSION_AUDIT_ENABLED=true
SESSION_AUDIT_LOG_REFRESH=false
CURRENT_USER_AUTHENTICATE_SAFE_METHODS=false

